<Window x:Class="WpfCodeImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCodeImage"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74*"/>
            <ColumnDefinition Width="305*"/>
            <ColumnDefinition Width="21*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Grid.ColumnSpan="3">
            <Border BorderBrush="Blue" BorderThickness="3" CornerRadius="20" Height="768" Width="1024">
                <local:CheckCode Width="200" Height="100"/>
            </Border>
        </Viewbox>

        <!--<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <local:CheckCode Width="200" Height="60"/>
            <local:CheckCode Width="200" Height="60"/>
        </StackPanel>-->
    </Grid>
</Window>
